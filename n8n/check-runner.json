{"active":false,"connections":{"Decide action":{"main":[[{"node":"Switch on action","type":"main"}]]},"Get active monitors":{"main":[[{"node":"Get recent checks","type":"main"}]]},"Get open incident":{"main":[[{"node":"Decide action","type":"main"}]]},"Get recent checks":{"main":[[{"node":"Select due monitors","type":"main"}]]},"IF any due?":{"main":[[{"node":"Loop over monitors","type":"main"}],[{"node":"All quiet","type":"main"}]]},"Insert check":{"main":[[{"node":"Get open incident","type":"main"}]]},"Loop over monitors":{"main":[[{"node":"Stamp start","type":"main"}],[{"node":"Run finished","type":"main"}]]},"Notify: recovered":{"main":[[{"node":"Loop over monitors","type":"main"}]]},"Notify: site down":{"main":[[{"node":"Loop over monitors","type":"main"}]]},"Open incident":{"main":[[{"node":"Notify: site down","type":"main"}]]},"Probe URL":{"main":[[{"node":"Build check row","type":"main"}]]},"Build check row":{"main":[[{"node":"Insert check","type":"main"}]]},"Resolve incident":{"main":[[{"node":"Notify: recovered","type":"main"}]]},"Schedule Trigger":{"main":[[{"node":"Get active monitors","type":"main"}]]},"Select due monitors":{"main":[[{"node":"IF any due?","type":"main"}]]},"Stamp start":{"main":[[{"node":"Probe URL","type":"main"}]]},"Switch on action":{"main":[[{"node":"Open incident","type":"main"}],[{"node":"Resolve incident","type":"main"}],[{"node":"Loop over monitors","type":"main"}]]}},"name":"Uptime Monitor — check runner","nodes":[{"id":"a1b2c3d4-0001-4000-8000-000000000001","name":"Schedule Trigger","parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":1}]}},"position":[240,300],"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2},{"id":"a1b2c3d4-0002-4000-8000-000000000002","name":"Sticky Note","parameters":{"content":"## Check runner — setup\n1. Create a **Supabase API** credential in n8n using your project's **service_role** key (NOT the anon key — n8n must bypass RLS to write checks/incidents).\n2. Attach that credential to the three Supabase nodes in this workflow.\n3. Import **alert-dispatcher**, then open the two **Execute Workflow** nodes below and select it (\"Notify: site down\" / \"Notify: recovered\").\n4. Activate this workflow. It runs every minute and only probes monitors whose `interval_minutes` have elapsed since their last check.","height":520,"width":380},"position":[180,80],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"a1b2c3d4-0003-4000-8000-000000000003","name":"Get active monitors","parameters":{"resource":"row","operation":"getAll","tableId":"monitors","returnAll":true,"filterType":"manual","filters":{"conditions":[{"keyName":"is_active","condition":"equal","keyValue":true}]}},"position":[460,300],"credentials":{"supabaseApi":{"id":"","name":"Supabase service_role — create this credential"}},"type":"n8n-nodes-base.supabase","typeVersion":1},{"id":"a1b2c3d4-0004-4000-8000-000000000004","name":"Get recent checks","parameters":{"resource":"row","operation":"getAll","tableId":"checks","returnAll":false,"limit":3000,"options":{"sort":"checked_at:desc"}},"position":[680,300],"credentials":{"supabaseApi":{"id":"","name":"Supabase service_role — create this credential"}},"type":"n8n-nodes-base.supabase","typeVersion":1},{"id":"a1b2c3d4-0005-4000-8000-000000000005","name":"Select due monitors","parameters":{"jsCode":"// Monitors come from the earlier node; checks are the current input (sorted newest-first).\nconst now = Date.now();\nconst monitors = $('Get active monitors').all().map(i => i.json);\nconst latest = {};\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (c.monitor_id && !(c.monitor_id in latest)) latest[c.monitor_id] = c;\n}\nconst due = [];\nfor (const m of monitors) {\n  const last = latest[m.id];\n  const ageMs = last ? now - new Date(last.checked_at).getTime() : Infinity;\n  if (ageMs >= (m.interval_minutes || 5) * 60000) due.push({ json: m });\n}\nreturn due;"},"position":[900,300],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"a1b2c3d4-0006-4000-8000-000000000006","name":"IF any due?","parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"cond-due","leftValue":"={{ $input.all().length }}","rightValue":0,"operator":{"type":"number","operation":"larger"}}],"combinator":"and"},"options":{}},"position":[1120,300],"type":"n8n-nodes-base.if","typeVersion":2},{"id":"a1b2c3d4-0007-4000-8000-000000000007","name":"Loop over monitors","parameters":{"batchSize":1,"options":{}},"position":[1340,300],"type":"n8n-nodes-base.splitInBatches","typeVersion":3},{"id":"a1b2c3d4-0008-4000-8000-000000000008","name":"Stamp start","parameters":{"jsCode":"const m = $input.first().json;\nreturn [{ json: { ...m, check_started_at: Date.now() } }];"},"position":[1560,300],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"a1b2c3d4-0009-4000-8000-000000000009","name":"Probe URL","parameters":{"method":"GET","url":"={{$json.url}}","options":{"timeout":"={{$json.timeout_ms}}","response":{"response":{"responseFormat":"autodetect"}}}},"position":[1780,300],"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"onError":"continueRegularOutput"},{"id":"a1b2c3d4-000a-4000-8000-00000000000a","name":"Build check row","parameters":{"jsCode":"const m = $input.first().json;\nconst elapsed = Date.now() - (m.check_started_at || Date.now());\nconst statusCode = typeof m.statusCode === 'number' ? m.statusCode : null;\nconst err = m.error ? String(m.error.message || m.error) : null;\nconst is_up = statusCode !== null && statusCode === m.expected_status && !err;\nreturn [{ json: {\n  monitor_id: m.id, monitor_name: m.name, monitor_url: m.url,\n  user_id: m.user_id, expected_status: m.expected_status,\n  status_code: statusCode, response_time_ms: elapsed,\n  is_up, error: err\n}}];"},"position":[2000,300],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"a1b2c3d4-000b-4000-8000-00000000000b","name":"Insert check","parameters":{"resource":"row","operation":"create","tableId":"checks","columns":{"mappingMode":"defineBelow","value":{"monitor_id":"={{$json.monitor_id}}","status_code":"={{$json.status_code}}","response_time_ms":"={{$json.response_time_ms}}","is_up":"={{$json.is_up}}","error":"={{$json.error}}"},"matchingColumns":[],"schema":[]}},"position":[2220,300],"credentials":{"supabaseApi":{"id":"","name":"Supabase service_role — create this credential"}},"type":"n8n-nodes-base.supabase","typeVersion":1},{"id":"a1b2c3d4-000c-4000-8000-00000000000c","name":"Get open incident","parameters":{"resource":"row","operation":"getAll","tableId":"incidents","returnAll":false,"limit":1,"alwaysOutputData":true,"filterType":"manual","filters":{"conditions":[{"keyName":"monitor_id","condition":"equal","keyValue":"={{$json.monitor_id}}"}]},"options":{"sort":"started_at:desc"}},"position":[2440,300],"credentials":{"supabaseApi":{"id":"","name":"Supabase service_role — create this credential"}},"type":"n8n-nodes-base.supabase","typeVersion":1},{"id":"a1b2c3d4-000d-4000-8000-00000000000d","name":"Decide action","parameters":{"jsCode":"const check = $('Build check row').first().json;\nconst inc = $input.first().json || {};\nconst hasOpen = !!(inc.id && !inc.resolved_at);\nlet action = 'none';\nif (!check.is_up && !hasOpen) action = 'open';\nelse if (check.is_up && hasOpen) action = 'resolve';\nconst downtime_seconds = hasOpen ? Math.round((Date.now() - new Date(inc.started_at).getTime()) / 1000) : null;\nreturn [{ json: { action, ...check,\n  incident_id: hasOpen ? inc.id : null,\n  incident_started_at: hasOpen ? inc.started_at : null,\n  downtime_seconds } }];"},"position":[2660,300],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"a1b2c3d4-000e-4000-8000-00000000000e","name":"Switch on action","parameters":{"dataType":"string","value1":"={{$json.action}}","rules":{"values":[{"renameOutput":true,"outputKey":"open","conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"sw-open","leftValue":"={{$json.action}}","rightValue":"open","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},{"renameOutput":true,"outputKey":"resolve","conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"sw-resolve","leftValue":"={{$json.action}}","rightValue":"resolve","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}}]},"options":{"fallbackOutput":"extra","renameFallbackOutput":"none"}},"position":[2880,300],"type":"n8n-nodes-base.switch","typeVersion":3},{"id":"a1b2c3d4-000f-4000-8000-00000000000f","name":"Open incident","parameters":{"resource":"row","operation":"create","tableId":"incidents","columns":{"mappingMode":"defineBelow","value":{"monitor_id":"={{$json.monitor_id}}"},"matchingColumns":[],"schema":[]}},"position":[3100,220],"credentials":{"supabaseApi":{"id":"","name":"Supabase service_role — create this credential"}},"type":"n8n-nodes-base.supabase","typeVersion":1},{"id":"a1b2c3d4-0010-4000-8000-000000000010","name":"Notify: site down","parameters":{"source":"database","workflowId":"","workflowInputs":{"value":{"event":"down","monitor_name":"={{$json.monitor_name}}","monitor_url":"={{$json.monitor_url}}","user_id":"={{$json.user_id}}","status_code":"={{$json.status_code}}","expected_status":"={{$json.expected_status}}","error":"={{$json.error}}"},"schema":[]}},"position":[3320,220],"type":"n8n-nodes-base.executeWorkflow","typeVersion":1},{"id":"a1b2c3d4-0011-4000-8000-000000000011","name":"Resolve incident","parameters":{"resource":"row","operation":"update","tableId":"incidents","filterType":"manual","filters":{"conditions":[{"keyName":"id","condition":"equal","keyValue":"={{$json.incident_id}}"}]},"columns":{"mappingMode":"defineBelow","value":{"resolved_at":"={{$now.toISO()}}","downtime_seconds":"={{$json.downtime_seconds}}"},"matchingColumns":[],"schema":[]}},"position":[3100,380],"credentials":{"supabaseApi":{"id":"","name":"Supabase service_role — create this credential"}},"type":"n8n-nodes-base.supabase","typeVersion":1},{"id":"a1b2c3d4-0012-4000-8000-000000000012","name":"Notify: recovered","parameters":{"source":"database","workflowId":"","workflowInputs":{"value":{"event":"recovered","monitor_name":"={{$json.monitor_name}}","monitor_url":"={{$json.monitor_url}}","user_id":"={{$json.user_id}}","downtime_seconds":"={{$json.downtime_seconds}}"},"schema":[]}},"position":[3320,380],"type":"n8n-nodes-base.executeWorkflow","typeVersion":1},{"id":"a1b2c3d4-0013-4000-8000-000000000013","name":"All quiet","parameters":{},"position":[1340,480],"type":"n8n-nodes-base.noOp","typeVersion":1},{"id":"a1b2c3d4-0014-4000-8000-000000000014","name":"Run finished","parameters":{},"position":[1560,480],"type":"n8n-nodes-base.noOp","typeVersion":1}],"pinData":{},"settings":{"executionOrder":"v1"},"tags":[{"name":"uptime-monitor"}]}
