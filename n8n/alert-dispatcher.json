{"active":false,"connections":{"Execute Workflow Trigger":{"main":[[{"node":"Format alert","type":"main"}]]},"Format alert":{"main":[[{"node":"Get alert targets","type":"main"}]]},"Get alert targets":{"main":[[{"node":"Loop over targets","type":"main"}]]},"Loop over targets":{"main":[[{"node":"Switch on type","type":"main"}],[{"node":"All alerts sent","type":"main"}]]},"Send email":{"main":[[{"node":"Loop over targets","type":"main"}]]},"Send telegram":{"main":[[{"node":"Loop over targets","type":"main"}]]},"Send webhook":{"main":[[{"node":"Loop over targets","type":"main"}]]},"Switch on type":{"main":[[{"node":"Send telegram","type":"main"}],[{"node":"Send email","type":"main"}],[{"node":"Send webhook","type":"main"}],[]]}},"name":"Uptime Monitor — alert dispatcher","nodes":[{"id":"b1c2d3e4-0001-4000-8000-000000000001","name":"Execute Workflow Trigger","parameters":{"workflowInputs":{"values":[]}},"position":[240,300],"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1},{"id":"b1c2d3e4-0002-4000-8000-000000000002","name":"Sticky Note","parameters":{"content":"## Alert dispatcher — setup\nCalled by the **check runner** with `{event, monitor_name, monitor_url, user_id, ...}`.\n\n1. Create a **Supabase API** credential with your **service_role** key and attach it to \"Get alert targets\".\n2. **Telegram:** create a bot via @BotFather, then create a **Telegram API** credential with the bot token. Users add targets in the dashboard with their own `chat_id` (message @userinfobot to find it).\n3. **Email:** create an **SMTP** credential (Gmail App Password, SendGrid, etc.) and attach it to \"Send email\".\n4. **Webhook:** no credential needed — the URL comes from each user's target config.\n5. Leave this workflow **inactive** (it only runs when called).","height":560,"width":380},"position":[180,80],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"b1c2d3e4-0003-4000-8000-000000000003","name":"Format alert","parameters":{"jsCode":"const d = $input.first().json;\nconst when = new Date().toISOString();\nlet subject, text;\nif (d.event === 'down') {\n  subject = `[DOWN] ${d.monitor_name}`;\n  text = `[DOWN] ${d.monitor_name}\\n${d.monitor_url}\\n` +\n    `HTTP ${d.status_code ?? 'no response'} (expected ${d.expected_status}) at ${when}\\n` +\n    (d.error ? `Error: ${d.error}\\n` : '') +\n    `You'll get a recovery notice when it's back.`;\n} else {\n  subject = `[RECOVERED] ${d.monitor_name}`;\n  text = `[RECOVERED] ${d.monitor_name}\\n${d.monitor_url}\\n` +\n    `Back up after ${d.downtime_seconds ?? '?'}s of downtime.`;\n}\nreturn [{ json: { ...d, subject, text } }];"},"position":[460,300],"type":"n8n-nodes-base.code","typeVersion":2},{"credentials":{"supabaseApi":{"id":"","name":"Supabase service_role — create this credential"}},"id":"b1c2d3e4-0004-4000-8000-000000000004","name":"Get alert targets","parameters":{"filterType":"manual","filters":{"conditions":[{"condition":"equal","keyName":"user_id","keyValue":"={{$json.user_id}}"},{"condition":"equal","keyName":"is_active","keyValue":true}]},"operation":"getAll","resource":"row","returnAll":true,"tableId":"alert_targets"},"position":[680,300],"type":"n8n-nodes-base.supabase","typeVersion":1},{"id":"b1c2d3e4-0005-4000-8000-000000000005","name":"Loop over targets","parameters":{"batchSize":1,"options":{}},"position":[900,300],"type":"n8n-nodes-base.splitInBatches","typeVersion":3},{"id":"b1c2c3e4-0006-4000-8000-000000000006","name":"Switch on type","parameters":{"dataType":"string","options":{},"rules":{"values":[{"conditions":{"combinator":"and","conditions":[{"id":"sw-tg","leftValue":"={{$json.type}}","operator":{"operation":"equals","type":"string"},"rightValue":"telegram"}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"}},"outputKey":"telegram","renameOutput":true},{"conditions":{"combinator":"and","conditions":[{"id":"sw-em","leftValue":"={{$json.type}}","operator":{"operation":"equals","type":"string"},"rightValue":"email"}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"}},"outputKey":"email","renameOutput":true},{"conditions":{"combinator":"and","conditions":[{"id":"sw-wh","leftValue":"={{$json.type}}","operator":{"operation":"equals","type":"string"},"rightValue":"webhook"}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"}},"outputKey":"webhook","renameOutput":true}]},"value1":"={{$json.type}}"},"position":[1120,300],"type":"n8n-nodes-base.switch","typeVersion":3},{"credentials":{"telegramApi":{"id":"","name":"Telegram bot — create via @BotFather"}},"id":"b1c2d3e4-0007-4000-8000-000000000007","name":"Send telegram","parameters":{"additionalFields":{},"chatId":"={{$json.config.chat_id}}","text":"={{$('Format alert').first().json.text}}"},"position":[1340,220],"type":"n8n-nodes-base.telegram","typeVersion":1.2},{"credentials":{"smtp":{"id":"","name":"SMTP — your mail provider"}},"id":"b1c2d3e4-0008-4000-8000-000000000008","name":"Send email","parameters":{"emailType":"text","message":"={{$('Format alert').first().json.text}}","options":{},"sendTo":"={{$json.config.to}}","subject":"={{$('Format alert').first().json.subject}}"},"position":[1340,340],"type":"n8n-nodes-base.emailSend","typeVersion":2},{"id":"b1c2d3e4-0009-4000-8000-000000000009","name":"Send webhook","parameters":{"jsonBody":"={{ JSON.stringify({ event: $('Format alert').first().json.event, monitor_name: $('Format alert').first().json.monitor_name, monitor_url: $('Format alert').first().json.monitor_url, text: $('Format alert').first().json.text }) }}","method":"POST","options":{},"sendBody":true,"specifyBody":"json","url":"={{$json.config.url}}"},"position":[1340,460],"type":"n8n-nodes-base.httpRequest","typeVersion":4.2},{"id":"b1c2d3e4-000a-4000-8000-00000000000a","name":"All alerts sent","parameters":{},"position":[1120,480],"type":"n8n-nodes-base.noOp","typeVersion":1}],"pinData":{},"settings":{"executionOrder":"v1"},"tags":[{"name":"uptime-monitor"}]}